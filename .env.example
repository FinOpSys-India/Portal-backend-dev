# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Server ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Single mount point for every API router (see src/app.js). Change it to version
# the whole surface at once, e.g. /api/v2.
API_PREFIX=/api

# Number of proxy hops in front of the app (e.g. 1 behind nginx/Render/Fly).
# Leave empty when exposed directly. Required for per-IP rate limiting to work
# behind a proxy. Use the real hop count, not `true`.
TRUST_PROXY=

# URL the invitation links point at (no trailing slash).
FRONTEND_URL=http://localhost:5173

# --- Auth ---
# Secret for signing access-token JWTs. REQUIRED in production (the app refuses
# to start without it). Generate one with: openssl rand -hex 32
JWT_SECRET=
# Access token lifetime (any ms/vercel-style duration, e.g. 15m, 1h).
ACCESS_TOKEN_TTL=165m
# Refresh token lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30
# bcrypt cost factor. Higher is more secure but slower.
BCRYPT_ROUNDS=12
# Optional: token issuer/audience claims.
JWT_ISSUER=finopsys-portal
JWT_AUDIENCE=finopsys-portal-api

# Password attempt limiter: lock the account for LOGIN_LOCK_MINUTES after
# MAX_LOGIN_ATTEMPTS consecutive failures (a temporary lock, never permanent).
# At 1440 (24h) the lock is too long to wait out, so a completed password reset
# — which clears it immediately — becomes the practical way back in. Keep the
# reset emails working, or a locked-out user has no route back.
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=1440

# --- Login email OTP ---
# Secret for the OTP HMAC digest. REQUIRED in production (the app refuses to
# start without it). Must differ from JWT_SECRET. Generate: openssl rand -hex 32
OTP_SECRET=
# OTP lifetime in seconds (default 300 = five minutes).
OTP_TTL_SECONDS=300
# Max wrong OTP guesses per challenge before it is invalidated.
OTP_MAX_ATTEMPTS=5
# Minimum seconds between resends, and max resends per challenge.
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3

# --- Password reset ---
# The reset OTP reuses the OTP_* settings above. This is the lifetime of the
# ticket minted once that code is verified — the window in which the user must
# submit their new password. Keep it short: it is bearer permission to change a
# password (default 600 = ten minutes).
PASSWORD_RESET_TICKET_TTL_SECONDS=600

# --- Stripe / billing ---
# Server-side secret key. REQUIRED in production (the app refuses to start
# without it). Outside production the billing routes answer 503 until it is set,
# so the rest of the API still runs with no Stripe account.
STRIPE_SECRET_KEY=sk_test_51SDfoHFGFESLnZlWbn5n3KTMyKSVKpY38rlRUL1B537muNk9v9jeBIhLUKWMdCJMiy3yPwFpu9p4dSHJsFzz6Ir100nBa0B5El
# Signing secret for the webhook endpoint (Stripe dashboard -> Developers ->
# Webhooks -> your endpoint -> Signing secret). REQUIRED in production. Get one
# for local development with:  stripe listen --forward-to
#   localhost:3000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_3d8f1592d5c20ff96cb1e07602490cb60cf224e41bdc067d477a3d26e03802c2
# Leave unset to use the SDK's pinned API version. Only set this once you have
# tested against that exact version.
# STRIPE_API_VERSION=

# Re-read every Price from Stripe before it reaches a Checkout Session, so a
# price deactivated or re-pointed in the dashboard cannot be sold from a stale
# local row. Set to false ONLY for offline development; forced off under test.
STRIPE_VERIFY_PRICES=true
# How long a verified Price object is memoised, in seconds.
STRIPE_PRICE_CACHE_TTL_SECONDS=60

# Where Stripe returns the browser. {CHECKOUT_SESSION_ID} is substituted by
# Stripe. Default to FRONTEND_URL + /payment/success | /payment/cancelled.
# STRIPE_CHECKOUT_SUCCESS_URL=https://app.example.com/payment/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCELLED_URL is spelled CANCEL below, matching Stripe's own field.
# STRIPE_CHECKOUT_CANCEL_URL=https://app.example.com/payment/cancelled

# The only currency the checkout flow will assemble. Every resolved Price must
# match, so a plan mis-seeded in another currency cannot join the session.
BILLING_SUPPORTED_CURRENCY=USD
# Sanity ceilings on the payroll head counts. Not business limits — they stop a
# typo turning into a five-figure invoice.
BILLING_MAX_EMPLOYEE_COUNT=5000
BILLING_MAX_CONTRACTOR_COUNT=5000
# Echo resolved Stripe product/price ids in the pricing summary. Handy while
# wiring the frontend up; defaults to false in production.
# BILLING_EXPOSE_STRIPE_IDS=false

# What Stripe does about money already paid when a payroll head count changes
# mid-period. create_prorations (default) credits the unused part of the old
# quantity and charges the new one pro rata, settling on the next invoice.
# Alternatives: none (change applies next period), always_invoice (bill now).
BILLING_PRORATION_BEHAVIOR=create_prorations
# Where Stripe's hosted billing portal returns the browser.
# STRIPE_PORTAL_RETURN_URL=https://app.example.com/billing
# Page-size cap for GET /billing/payments.
BILLING_MAX_PAGE_SIZE=100

# OPTIONAL environment pins. The plan catalog lives in the `service_plans` table
# and is the single source of truth for Stripe ids. When a variable below is set,
# the catalog row MUST match it or the request is refused with
# STRIPE_PRODUCT_PRICE_MISMATCH. A pin can only reject an id, never supply one —
# that is what keeps it from becoming a second catalog that silently drifts.
# Leave them all unset unless you specifically want the environment to have a
# veto over what the database offers for sale.
# STRIPE_BOOKKEEPING_PRODUCT_ID=
# STRIPE_BOOKKEEPING_PRICE_ID_1=
# STRIPE_BOOKKEEPING_PRICE_ID_2=
# STRIPE_BOOKKEEPING_PRICE_ID_3=
# STRIPE_BOOKKEEPING_PRICE_ID_4=
# STRIPE_TAX_PRODUCT_ID=
# STRIPE_TAX_PRICE_ID_1=
# STRIPE_TAX_PRICE_ID_2=
# STRIPE_TAX_PRICE_ID_3=
# STRIPE_PAYROLL_BASE_PRODUCT_ID=
# STRIPE_PAYROLL_BASE_PRICE_ID=
# STRIPE_PAYROLL_EMPLOYEE_PRODUCT_ID=
# STRIPE_PAYROLL_EMPLOYEE_PRICE_ID=
# STRIPE_PAYROLL_CONTRACTOR_PRODUCT_ID=
# STRIPE_PAYROLL_CONTRACTOR_PRICE_ID=

# --- Database ---
# Full connection string; takes precedence over the DB_* vars below.
# Supabase: Project settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Used only when DATABASE_URL is unset.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=portal
# DB_SSL=false

# Pool and transaction timings. The defaults suit a remote database (Supabase)
# where opening a connection costs a TLS handshake; raise them further on a slow
# link if you still see P2028 "unable to start a transaction".
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=15000
# DB_TX_MAX_WAIT_MS=15000
# DB_TX_TIMEOUT_MS=20000

# --- Supabase (optional; not used by the backend today) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Email (SMTP) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=pyadav@finopsys.ai
SMTP_PASSWORD=Pratibha@1@1@1
SMTP_FROM=pyadav@finopsys.ai
# Mailbox the SMTP provider authorises you to send from.
SMTP_FROM=
SMTP_FROM_NAME=Admin
